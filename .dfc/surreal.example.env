# dev-flow-control — SurrealDB dev-memory connection (TEMPLATE)
#
# Default mode: EMBEDDED SurrealKV. No server, no credentials — the database lives
# inside the repo at .dfc/dev-memory/ (gitignored). A fresh clone works with no
# config at all; this template just makes the defaults explicit. Relative
# surrealkv:// paths resolve against the target repo root.
#
# Constraint: SurrealKV allows ONE process at a time (LOCK file in the data dir).
# Never run two dfc commands concurrently against the same embedded database.
#
# To use real values, copy this file to `.dfc/surreal.env` (gitignored) and edit,
# OR export the same names as environment variables. Environment variables ALWAYS
# override both this template and `.dfc/surreal.env`.

DFC_SURREAL_URL=surrealkv://.dfc/dev-memory
DFC_SURREAL_NS=dev_flow_control
DFC_SURREAL_DB=repo_dev_flow_control
DFC_REPO_ID=dev-flow-control

# --- Alternative: hosted SurrealDB (Cloud or self-hosted server) ---
# Shared multi-machine memory; needs credentials. One hosted instance can serve
# many repos: keep ONE namespace and use ONE database per repo
# (DFC_SURREAL_DB=repo_<repo_slug>, DFC_REPO_ID=<repo_slug>).
#
# DFC_SURREAL_URL=wss://<your-surrealdb-cloud-endpoint>
# DFC_SURREAL_USER=<username>
# DFC_SURREAL_PASS=<password>
# DFC_SURREAL_AUTH_SCOPE=root
