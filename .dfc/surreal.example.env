# dev-flow-control-codex - hosted SurrealDB 3.1 dev-memory connection (TEMPLATE)
#
# This file is a committed template with placeholder values. To configure a real
# connection, copy it to `.dfc/surreal.env` (gitignored) and fill in real values,
# OR export these as environment variables. Environment variables ALWAYS override
# both this template and `.dfc/surreal.env`.
#
# One hosted SurrealDB instance can serve many repos: keep ONE namespace and use
# ONE database per repo (DFC_SURREAL_DB=repo_<repo_slug>, DFC_REPO_ID=<repo_slug>).

DFC_SURREAL_URL=wss://<your-surrealdb-cloud-endpoint>
DFC_SURREAL_NS=dev_flow_control
DFC_SURREAL_DB=repo_dev_flow_control_codex
DFC_REPO_ID=dev-flow-control-codex
DFC_SURREAL_USER=<username>
DFC_SURREAL_PASS=<password>
DFC_SURREAL_AUTH_SCOPE=root
