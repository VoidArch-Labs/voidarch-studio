# dev-flow-control - optional embedding provider config (TEMPLATE)
#
# Copy to `.dfc/embed.env` (gitignored) only when you intentionally enable
# vector embeddings. OpenAI is a paid provider and still requires approval.

DFC_EMBED_PROVIDER=none
# DFC_EMBED_PROVIDER=openai
# DFC_EMBED_MODEL=text-embedding-3-small
# DFC_EMBED_DIMENSION=1536
# DFC_EMBED_APPROVED=0
# OPENAI_API_KEY=<your-openai-api-key>
