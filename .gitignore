# Runtime observability + session state + scoped approvals (created in target repos at session time)
# Includes .agent-runs/sessions/<id>/, .agent-runs/approvals/, consumed markers, and graph output.
.agent-runs/

# Generated repo knowledge graph (graphify). Regenerate with /graphify; do not commit.
graphify-out/

# DEPRECATED broad approval override flags (honored only with DFC_ALLOW_LEGACY_FLAGS=1; unsafe).
# Prefer scoped approval records under .agent-runs/approvals/. Never commit these.
.allow-protected-edits
.allow-dependency-changes
.allow-destructive-shell
.allow-mcp-writes
.strict-verify

# Node dependencies + build output for the dev-memory slice
node_modules/
dist/

# Local DFC credentials. NEVER commit real values; keep only templates.
.dfc/*.env
!.dfc/surreal.example.env
!.dfc/embed.example.env
!.dfc/grok.example.env

# OS / editor cruft
.DS_Store
*.swp
