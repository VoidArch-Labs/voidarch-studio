{
  "name": "dev-flow-control",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin with a shared, agent-neutral hosted SurrealDB dev-memory CLI (dfc).",
  "license": "MIT",
  "scripts": {
    "dfc:db:check": "tsx scripts/dfc-db-check.ts",
    "dfc:db:migrate": "tsx scripts/dfc-db-migrate.ts",
    "dfc:ingest": "tsx scripts/dfc-ingest-repo.ts",
    "dfc:remember": "tsx scripts/dfc-remember.ts",
    "dfc:memory": "tsx scripts/dfc-memory.ts",
    "dfc:task": "tsx scripts/dfc-task.ts",
    "dfc:blocker": "tsx scripts/dfc-blocker.ts",
    "dfc:metrics": "tsx scripts/dfc-metrics.ts",
    "dfc:sync": "tsx scripts/dfc-sync.ts",
    "dfc:context": "tsx scripts/dfc-context-pack.ts",
    "dfc:status": "tsx scripts/dfc-status.ts",
    "dfc:import-runs": "tsx scripts/dfc-import-runs.ts",
    "dfc:log-run": "tsx scripts/dfc-log-run.ts",
    "dfc:log-tool": "tsx scripts/dfc-log-tool.ts",
    "dfc:docs:ingest": "tsx scripts/dfc-docs-ingest.ts",
    "dfc:docs:query": "tsx scripts/dfc-docs-query.ts",
    "dfc:graph:build": "tsx scripts/dfc-graph-build.ts",
    "dfc:graph:import": "tsx scripts/dfc-graph-import.ts",
    "dfc:graph:query": "tsx scripts/dfc-graph-query.ts",
    "dfc:graph:status": "tsx scripts/dfc-graph-status.ts",
    "dfc:embed": "tsx scripts/dfc-embed.ts",
    "dfc:memory:doctor": "tsx scripts/dfc-memory-doctor.ts",
    "dfc:memory:gc": "tsx scripts/dfc-memory-gc.ts",
    "dfc:grok-build": "tsx scripts/dfc-grok-build.ts",
    "dfc:validate-hooks": "bash scripts/dfc-validate-hooks.sh",
    "dfc:init": "tsx scripts/dfc-init.ts",
    "dfc:dashboard": "tsx scripts/dfc-dashboard.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@surrealdb/node": "^3.0.3",
    "surrealdb": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
